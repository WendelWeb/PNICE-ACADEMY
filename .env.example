# PNICE Academy — environment variables (NAMES ONLY — never commit real values).
# Copy to .env.local and fill in. The app runs on mock data until these are set;
# /admin/sante shows which integrations are configured.

# ─── Site URL — required before you go live ─────────────────────────────────
# The site's real public domain, no trailing slash (e.g. https://pnice.academy).
# Without it, EVERY absolute link this app builds (email CTAs, og:image tags,
# sitemap.xml, robots.txt, certificate verify links) silently falls back to a
# placeholder domain (lib/email/layout.ts's `SITE_URL`) — emails would point
# your customers at a domain you may not even own. Set this the moment you
# buy a domain (Étape 3 of docs/launch-checklist.md), well before going live.
NEXT_PUBLIC_SITE_URL=

# Manual USD→HTG display rate (placeholder 132 if unset) — update at launch
# and whenever the real rate drifts. Superseded on every DYNAMIC page once
# `ADMIN_DATA_SOURCE=real` (those read the live, admin-editable rate at
# /admin/taux instead — see lib/fx.ts); this env var stays the fallback for
# static pages and the no-DB case.
NEXT_PUBLIC_USD_TO_HTG=132

# ─── Data source ────────────────────────────────────────────────────────────
# 'mock' (default) serves the in-memory demo dataset. 'real' routes the admin
# through realDataSource() (Drizzle). Only flip to 'real' once DATABASE_URL is
# set and realDataSource() is implemented.
ADMIN_DATA_SOURCE=mock

# ─── Database (Neon Postgres) ───────────────────────────────────────────────
# Required. From the Neon console (use the pooled connection string).
DATABASE_URL=

# ─── Auth (Clerk) ───────────────────────────────────────────────────────────
# Required. From Clerk Dashboard → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Required for user-sync. Clerk Dashboard → Webhooks → endpoint /api/webhooks/clerk
# (subscribe to user.created/updated/deleted) → copy the signing secret.
CLERK_WEBHOOK_SECRET=
# First super-admin bootstrap (comma-separated emails). Can be removed after the
# role is persisted on first /admin visit.
ADMIN_BOOTSTRAP_EMAILS=
# Set to 'true' to require 2FA for admin access (default off).
ADMIN_REQUIRE_2FA=

# ─── Payments — at least one rail required to sell ──────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
NATCASH_API_KEY=

# ─── Site — public contact + social (all optional) ──────────────────────────
# WhatsApp number for the footer contact link, full international format,
# digits only (e.g. 50937000000). The link is hidden when unset/invalid.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Full https:// profile URLs — each footer social icon renders only when its
# URL is set (and parses as a real http(s) URL).
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_TIKTOK=

# ─── Email (Resend) ─────────────────────────────────────────────────────────
# ⚠ REQUIRES A VERIFIED DOMAIN to send to arbitrary recipients — defer until a
# domain is bought. Without it, all email is a safe no-op (logged + audited).
# Sending is ALSO gated on ADMIN_DATA_SOURCE=real (or EMAIL_LIVE=true) so fake
# mock addresses are never emailed.
RESEND_API_KEY=
RESEND_FROM=
# Set to 'true' to send real email BEFORE ADMIN_DATA_SOURCE=real (e.g. to
# test a receipt/dunning template against your OWN address while still on
# mock data). Once ADMIN_DATA_SOURCE=real this flag is redundant — sending
# is already live — but harmless to leave set.
EMAIL_LIVE=

# ─── Video + storage (Bunny) ────────────────────────────────────────────────
# Needed for lesson video + the /admin/sante Bunny health check.
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_LIBRARY_ID=
# (Optionnel, mais recommandé avant de publier des vidéos payantes) Clé
# « Token Authentication » de TA librairie Bunny Stream (dash.bunny.net →
# ta librairie → onglet API → active Token Authentication → copie la clé).
# Une fois posée ICI + activée côté dashboard Bunny, chaque URL d'embed est
# signée et expire après quelques heures — copier l'URL depuis le code
# source ne suffit plus à la repartager indéfiniment. Voir Étape 5 du
# launch-checklist. Vide = embed public non signé (comportement actuel).
BUNNY_EMBED_TOKEN_KEY=
# Fichiers (images de cours + ressources) — Bunny STORAGE, voir
# docs/launch-checklist.md → « Étape 5b ». Sans ces trois valeurs, l'upload de
# fichiers répond juste « non configuré » (aucun crash).
# Nom de la Storage Zone (dash.bunny.net → Storage).
BUNNY_STORAGE_ZONE_NAME=
# Mot de passe/API de la Storage Zone (onglet « FTP & API Access » → Password).
BUNNY_STORAGE_API_KEY=
# URL publique de la Pull Zone connectée à la zone, ex. https://xxx.b-cdn.net
BUNNY_STORAGE_CDN_BASE=
# (Optionnel) endpoint régional si la zone n'est PAS en région par défaut,
# ex. ny.storage.bunnycdn.com — sinon laisse vide (storage.bunnycdn.com).
# BUNNY_STORAGE_HOST=

# ─── Crons (Vercel) ──────────────────────────────────────────────────────────
# Bearer secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>` when
# it invokes app/api/cron/*. Without it, the cron routes return 503 (not a
# security hole — they're inert). Generate any random string; Vercel sets this
# automatically for you when you enable Cron Jobs on the project, or set it
# yourself under Project Settings → Environment Variables.
CRON_SECRET=

# ---------------------------------------------------------------------------
# MonCash (Digicel) — paiement mobile haïtien, pour les cours à l'unité.
# Sans ces clés, MonCash n'apparaît PAS comme moyen de paiement (le site ne
# promet jamais un rail qu'il ne peut pas débiter). Obtenues auprès de Digicel
# Business, après avoir déclaré ces deux URL dans leur formulaire :
#   Return Url (notification) : https://pniceacademy.com/api/webhooks/moncash
#   Alert Url  (page de merci): https://pniceacademy.com/api/payments/moncash/retour
# MonCash débite en GOURDES (conversion au taux de /admin/taux) et ne gère pas
# les paiements récurrents — les abonnements restent donc par carte.
MONCASH_CLIENT_ID=
MONCASH_CLIENT_SECRET=
# 'sandbox' (défaut) ou 'live'. Passer en live est un acte délibéré.
MONCASH_MODE=sandbox

# --- MonCash : quel fournisseur ? -------------------------------------------
# MonCash est joignable de deux façons. Laisse vide pour choisir
# automatiquement (direct si configuré, sinon bazik).
#   direct = API Digicel. Pas d'intermédiaire ni de commission d'agrégateur,
#            mais exige un contrat marchand Digicel (plusieurs semaines).
#   bazik  = Bazik (api.bazik.io), agrégateur haïtien. Identifiants en
#            libre-service, donc utilisable tout de suite.
# Nommer un fournisseur non configuré = MonCash désactivé (jamais de bascule
# silencieuse vers l'autre société).
MONCASH_PROVIDER=

# --- Bazik (agrégateur MonCash) ---------------------------------------------
# Créés sur le tableau de bord Bazik. L'environnement (sandbox ou production)
# est déterminé par les identifiants eux-mêmes : une seule URL de base.
BAZIK_USER_ID=
BAZIK_SECRET_KEY=
